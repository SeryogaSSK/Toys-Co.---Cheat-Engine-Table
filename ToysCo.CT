  <Comments>SeryogaSK reusable Cheat Engine table template. Structure and metadata placeholders only; no game addresses or active cheats.
</Comments>
  <LuaScript>-- Cheat Table Decorator
function decorateSSKTable()
  local mainForm = getMainForm()

  -- Main Form Styling
  mainForm.Caption = 'Toys Co. (Steam) - Enhanced Table [by SeryogaSK]'
  getAutoAttachList().add("ToysCo.exe")
end

-- Execute when table loads
decorateSSKTable()

</LuaScript>
